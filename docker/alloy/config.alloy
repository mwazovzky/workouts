// Discover all running Docker containers
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Define relabeling rules — targets = [] because rules are referenced via relabel_rules below
discovery.relabel "containers" {
  targets = []

  // Keep only web and worker containers
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "web|worker"
    action        = "keep"
  }

  // Static labels — consistent schema across all apps
  rule {
    target_label = "app"
    replacement  = sys.env("APP")
  }

  rule {
    target_label = "env"
    replacement  = sys.env("ENV")
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "logstream"
  }
}

// Tail logs — targets come directly from discovery.docker, rules applied via relabel_rules
loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.write.grafana_cloud.receiver]
}

// Push to Grafana Cloud Loki
loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username = sys.env("LOKI_USER_ID")
      password = sys.env("LOKI_API_TOKEN")
    }
  }
}

// Scrape Laravel /metrics endpoint (business + HTTP metrics)
prometheus.scrape "laravel_app" {
  targets = [{"__address__" = "web:80", "__metrics_path__" = "/metrics"}]

  bearer_token    = sys.env("METRICS_TOKEN")
  scrape_interval = "15s"
  scrape_timeout  = "10s"

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// MySQL exporter
prometheus.exporter.mysql "db" {
  data_source_name = sys.env("MYSQL_METRICS_DSN")
}

prometheus.scrape "mysql" {
  targets         = prometheus.exporter.mysql.db.targets
  scrape_interval = "30s"

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Remote write to Grafana Cloud Mimir
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("MIMIR_URL")

    basic_auth {
      username = sys.env("MIMIR_USER_ID")
      password = sys.env("MIMIR_API_TOKEN")
    }
  }

  external_labels = {
    app = sys.env("APP"),
    env = sys.env("ENV"),
  }
}
